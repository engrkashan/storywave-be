generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CREATOR
}

enum CreationType {
  STORY
  VIDEO
  IMAGE
  VOICEOVER
  PODCAST
}

enum Platform {
  INSTAGRAM
  YOUTUBE
  TIKTOK
  SPOTIFY
  LINKEDIN
  X
  FACEBOOK
  THREADS
  PINTEREST
  REDDIT
  SNAPCHAT
}

enum SocialPostStatus {
  PENDING
  SCHEDULED
  PUBLISHED
  FAILED
  RETRYING
  CANCELLED
}

enum MediaType {
  SCRIPT
  AUDIO
  IMAGE
  VIDEO
  SUBTITLE
  TRANSCRIPT
}

enum InputType {
  URL
  TEXT
  VIDEO
}

model User {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  fullName   String?
  email      String  @unique
  username   String  @unique
  password   String
  profileURL String?
  role       Role    @default(ADMIN)

  creations    Creation[]
  integrations Integration[]
  workflows    Workflow[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lastLoginAt DateTime?
  stories     Story[]
  videos      Video[]
  voiceovers  Voiceover[]
}

model Input {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  type      InputType
  source    String
  processed Boolean   @default(false)

  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId String   @db.ObjectId

  createdAt DateTime @default(now())
}

model Task {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  step     String
  status   String  @default("QUEUED")
  log      String?
  metadata Json?

  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId String   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Story {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  outline   String?
  content   String
  
  // Podcast support
  isPodcast Boolean  @default(false)
  audioURL  String?
  duration  Int?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId

  series            String?
  coverArtPrompt    String?
  coverArtURL       String?
  coverArtURL_1_1   String?
  coverArtURL_16_9  String?
  coverArtURL_9_16  String?
  seoContent        Json?
  visualSuggestions String?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Workflow  Workflow[]

  @@index([userId, createdAt(sort: Desc)])
}

model Video {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  video_16_9 String?
  video_9_16 String?
  fileURL    String?
  duration   Int?
  subtitles  String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Workflow  Workflow[]
}

model Voiceover {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  script   String
  audioURL String?
  voice    String?
  userId   String?

  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId String   @unique @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum WorkflowStatus {
  PENDING
  SCHEDULED
  PROCESSING
  CANCELLATION_REQUESTED
  USER_CONFIRMATION_REQUIRED
  COMPLETED
  FAILED
  CANCELLED
}

// ─── Storywave Editor: Scene Status ──────────────────────────────────────────
enum SceneStatus {
  PENDING
  GENERATING
  GENERATED
  REGENERATING
  REGEN_FAILED
  FAILED
}

model Workflow {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  type        CreationType
  subType     String?
  status      WorkflowStatus @default(PENDING)
  scheduledAt DateTime?
  metadata    Json?

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @db.ObjectId

  inputs       Input[]
  story        Story?       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  voiceover    Voiceover?
  video        Video?       @relation(fields: [videoId], references: [id], onDelete: Cascade)
  media        Media[]
  tasks        Task[]
  socialPosts  SocialPost[]
  scenes       Scene[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  storyId   String?  @db.ObjectId
  videoId   String?  @db.ObjectId

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

// ─── Storywave Editor: Per-Scene Record ──────────────────────────────────────
// Each generated scene gets one Scene record per (workflowId, index, ratio).
// Dual-platform stories produce two Scene records per index (16:9 and 9:16).
model Scene {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  status     SceneStatus @default(PENDING)

  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId String   @db.ObjectId

  // Scene position
  index Int     // 0-based within the story
  ratio String  // e.g. "16:9" or "9:16"

  // Timeline (locked at generation — never changed during regeneration)
  startSec    Float
  endSec      Float
  durationSec Float

  // Narration text for this scene's audio slot (from Whisper / buildNarrationSegments)
  narration String?

  // Media type for this scene's pipeline ("single_image" | "multi_image" | "video")
  mediaType String?

  // Prompts
  originalPrompt   String? // MGE-generated prompt — immutable history
  activePrompt     String? // Currently active prompt (= original or user-edited)
  userEditedPrompt String? // The user's manual edits; null when unchanged

  // Active version pointer
  activeVersion     Int @default(1)
  generationAttempts Int @default(0)

  // Active asset (points to the SceneVersion at activeVersion)
  assetUrl      String? // Cloudinary secure_url
  assetPublicId String? // Cloudinary public_id
  assetType     String? // "image" or "video"

  // Continuity data for regeneration (serialized from MGE frame output)
  compiledState    Json? // _compiledState from MGE frame loop
  directorDecision Json? // _directorDecision from MGE frame loop
  prevExitState    String? // exit_state of Scene N-1 (anchor for Scene N regen)

  // Character context for regeneration
  charactersInScene String[] // character ids/names active in this scene
  selectedRefs      Json?    // [{ id, name, url }] — refs actually used

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions SceneVersion[]

  @@index([workflowId, index])
  @@index([workflowId, status])
}

// ─── Storywave Editor: Scene Version History ─────────────────────────────────
model SceneVersion {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  version Int    // 1-based version counter

  scene   Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sceneId String @db.ObjectId

  // Asset
  assetUrl      String
  assetPublicId String?
  assetType     String  // "image" or "video"

  // Prompt used for this version
  prompt String

  // Generation metadata
  ratio          String? // "16:9" or "9:16"
  generationType String? // "initial" or "regen"
  metadata       Json?   // any extra params (model used, etc.)

  createdAt DateTime @default(now())

  @@index([sceneId, version])
}

model Creation {
  id       String       @id @default(auto()) @map("_id") @db.ObjectId
  type     CreationType
  title    String?
  content  String?
  mediaURL String?
  metadata Json?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Integration {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  platform    Platform
  accountId   String
  accessToken String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  type     MediaType
  fileUrl  String
  fileType String
  publicId String?
  metadata Json?

  workflow   Workflow? @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId String?   @db.ObjectId

  uploadedAt DateTime @default(now())
}

model SocialPost {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  mallaryJobId String?          // Job ID returned by Mallary API
  platform     String           // instagram, tiktok, youtube, facebook
  channelId    String           // Mallary channel/account ID
  channelName  String?          // Display name of the channel
  caption      String
  mediaUrl     String           // Video/image URL that was posted
  thumbnailUrl String?          // Cover art URL (used for YouTube, etc.)
  scheduledAt  DateTime?
  publishedAt  DateTime?
  status       SocialPostStatus @default(PENDING)
  errorMessage String?
  metadata     Json?            // Full Mallary API response

  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId String   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
